(executable
 (name main)
 (public_name weft)
 (libraries weft_app eio_main)
 (link_flags :standard
  (:include link_flags.sexp)))

(executable
 (name gen_logs)
 (public_name weft-gen-logs)
 (libraries unix)
 (link_flags :standard
  (:include link_flags.sexp)))

(executable
 (name debug_keys)
 (libraries notty notty.unix unix))

(rule
 (target link_flags.sexp)
 (deps static_flags.sh)
 (action
  (with-stdout-to %{target}
   (bash "sh %{dep:static_flags.sh}"))))
